        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "cccccccc-cccc-cccc-cccc-cccccccccccc",
      "name": "Send Nightly Report to CEO Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        780,
        300
      ]
    }
