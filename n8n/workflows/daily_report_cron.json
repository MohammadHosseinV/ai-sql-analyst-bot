      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/analyze",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"user_query\": \"گزارش جامع فروش امروز را بده: در روز جاری (امروز) چند سفارش تکمیل‌شده ثبت شده، مجموع درآمد امروز چند تومان بوده و پرفروش‌ترین دسته‌بندی امروز کدام بوده است؟\"\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb",
      "name": "Request Daily Executive Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_ADMIN_CHAT_ID }}",
