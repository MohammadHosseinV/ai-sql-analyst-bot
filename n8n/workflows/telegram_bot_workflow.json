{
  "name": "Autonomous Data Analyst - Interactive Telegram Bot",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "11111111-1111-1111-1111-111111111111",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ],
      "webhookId": "analyst-telegram-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.message?.text }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.message?.text }}",
              "rightValue": "/start",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "22222222-2222-2222-2222-222222222222",
      "name": "Check If Text Message",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $node[\"Telegram Trigger\"].json.message.chat.id }}",
        "text": "👋 **سلام! به دستیار هوشمند تحلیل داده‌های سازمانی خوش آمدید.**\n\nمن یک ایجنت هوش مصنوعی متصل به پایگاه داده فروشگاه اینترنتی هستم و می‌توانم سوالات تجاری شما را مستقیماً به کوئری‌های تحلیلی SQL تبدیل کرده و پاسخ دقیق و فوری ارائه دهم.\n\n💡 **چند نمونه سوال که می‌توانید از من بپرسید:**\n۱. پرفروش‌ترین دسته‌بندی محصولات در ماه گذشته کدام بوده و چه درآمدی ایجاد کرده؟\n۲. فروش امروز تا این لحظه چند تومان بوده و چه تعداد سفارش ثبت شده است؟\n۳. سهم شهر اصفهان از مجموع سفارش‌های تکمیل‌شده چقدر بوده است؟\n۴. پنج محصول پرفروش دسته الکترونیک و دیجیتال در تهران کدامند؟\n\nلطفاً سوال تحلیلی خود را به زبان فارسی یا انگلیسی بنویسید تا بررسی کنم:",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "Send Welcome Message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        700,
        480
      ]
    },
    {
      "parameters": {
        "operation": "sendChatAction",
        "chatId": "={{ $node[\"Telegram Trigger\"].json.message.chat.id }}",
        "action": "typing"
      },
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "Send Typing Action",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        700,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/analyze",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"user_query\": \"{{ $node[\"Telegram Trigger\"].json.message.text }}\"\n}",
        "options": {
          "timeout": 60000,
          "neverError": true
        }
      },
      "id": "55555555-5555-5555-5555-555555555555",
      "name": "Call FastAPI Analyze Endpoint",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        940,
        180
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.answer }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "66666666-6666-6666-6666-666666666666",
      "name": "Check API Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1180,
        180
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $node[\"Telegram Trigger\"].json.message.chat.id }}",
        "text": "=📊 **پاسخ تحلیل‌گر هوشمند داده:**\n\n{{ $json.answer }}\n\n───────────────────\n⚡ زمان پردازش: {{ $json.execution_time_ms }} میلی‌ثانیه | 🔄 اصلاح خودکار کوئری: {{ $json.retries_count }} مرتبه",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "77777777-7777-7777-7777-777777777777",
      "name": "Send Persian Answer to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1440,
        80
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $node[\"Telegram Trigger\"].json.message.chat.id }}",
        "text": "={{ $json.detail?.message || \"⚠️ خطایی در پردازش سوال شما رخ داد. لطفاً سوال خود را با جزئیات واضح‌تری مطرح کنید.\" }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "88888888-8888-8888-8888-888888888888",
      "name": "Send Error Message to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1440,
        280
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Check If Text Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check If Text Message": {
      "main": [
        [
          {
            "node": "Send Typing Action",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Welcome Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Typing Action": {
      "main": [
        [
          {
            "node": "Call FastAPI Analyze Endpoint",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call FastAPI Analyze Endpoint": {
      "main": [
        [
          {
            "node": "Check API Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check API Success": {
      "main": [
        [
          {
            "node": "Send Persian Answer to Telegram",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Error Message to Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d",
  "id": "telegram_bot_workflow",
  "tags": []
}
