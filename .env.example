# ==========================================
# 1. POSTGRESQL DATABASE CONFIGURATION
# ==========================================
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_analytics

# Superuser / Admin Credentials (Used for Migrations & Seeding ONLY)
POSTGRES_USER=admin_user
POSTGRES_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD_HERE

# Read-Only AI User Credentials (Used by FastAPI LLM SQL Executor ONLY)
DB_READONLY_USER=llm_reader
DB_READONLY_PASSWORD=YOUR_READONLY_PASSWORD_HERE

# Constructed SQLAlchemy Connection URLs
ADMIN_DATABASE_URL=postgresql+psycopg2://admin_user:YOUR_STRONG_ADMIN_PASSWORD_HERE@postgres_db:5432/ecommerce_analytics
READONLY_DATABASE_URL=postgresql+psycopg2://llm_reader:YOUR_READONLY_PASSWORD_HERE@postgres_db:5432/ecommerce_analytics

# ==========================================
# 2. DATA SEEDER CONFIGURATION (FAKER)
# ==========================================
SEED_CUSTOMERS_COUNT=1000
SEED_PRODUCTS_COUNT=500
SEED_ORDERS_COUNT=10000
FORCE_RESEED=false
RANDOM_SEED=42

# ==========================================
# 3. FASTAPI BACKEND & LLM CONFIGURATION
# ==========================================
APP_NAME="Autonomous Data Analyst API"
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Supported Providers: "openai" (e.g. Groq, OpenAI, Ollama) or "gemini"
LLM_PROVIDER=openai
LLM_API_KEY=YOUR_LLM_API_KEY_HERE
LLM_MODEL=openai/gpt-oss-120b
OPENAI_BASE_URL=https://api.groq.com/openai/v1

LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120
MAX_SQL_RETRIES=3
MAX_RESULT_ROWS=100

# ==========================================
# 4. N8N & TELEGRAM BOT CONFIGURATION
# ==========================================
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Asia/Tehran
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_ADMIN_CHAT_ID=YOUR_NUMERIC_CHAT_ID_HERE
WEBHOOK_URL=https://your-public-webhook-url.ngrok-free.dev
